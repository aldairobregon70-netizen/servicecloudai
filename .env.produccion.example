# ServiceCloud AI — variables para el servidor (compose.prod.yaml)
# Copia este archivo como .env en el servidor y completa los valores marcados con <...>.
# Nunca subas el .env real al repositorio.

APP_NAME="ServiceCloud AI"
# Genera la clave con:  echo "base64:$(openssl rand -base64 32)"
APP_KEY=<base64:...>
# IP pública o dominio del servidor (http:// mientras no haya certificado)
APP_URL=<http://IP_PUBLICA>
APP_TIMEZONE=America/Lima
APP_LOCALE=es
APP_FALLBACK_LOCALE=en

# Base de datos (la crea el contenedor pgsql con estos datos la primera vez)
DB_DATABASE=servicecloud_ai
DB_USERNAME=servicecloud
# Genera una contraseña con:  openssl rand -hex 16
DB_PASSWORD=<contraseña-segura>

# Puerto público de la aplicación en el servidor
APP_PORT=80

# IA: simulado (sin internet) | gemini
AI_DRIVER=simulado
GEMINI_API_KEY=
GEMINI_MODELO_TEXTO=
GEMINI_MODELO_EMBEDDING=

# API (pruebas de carga: subir API_RATE_LIMIT, p. ej. 100000, y reiniciar con up -d)
API_RATE_LIMIT=600
API_LOGIN_RATE_LIMIT=30
SANCTUM_EXPIRATION=480

# Si se pone un balanceador o proxy HTTPS delante, usar TRUSTED_PROXIES=*
TRUSTED_PROXIES=
